# ── Fyers API credentials ────────────────────────────────────────────────────
# Get these from https://myapi.fyers.in → My Apps
FYERS_APP_ID=your_app_id_here
FYERS_SECRET_KEY=your_secret_key_here
# On VPS: set to http://<YOUR_VPS_IP>:8080/callback
# Also update this same URL in your Fyers developer portal (myapi.fyers.in → My Apps → Redirect URI)
FYERS_REDIRECT_URI=http://127.0.0.1

# Port the temporary OAuth callback HTTP server listens on (VPS only, ignored on desktop)
OAUTH_CALLBACK_PORT=8080

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Get BOT_TOKEN from @BotFather on Telegram
# Get CHAT_ID from: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Strategy parameters ───────────────────────────────────────────────────────
# Only track Nifty 50 stocks with LTP below this price (₹)
MAX_STOCK_PRICE=800
# Maximum ORB range (%) for a stock to qualify — stocks with wider range are dropped
ORB_RANGE_THRESHOLD=0.6

# Position sizing — 5× buying power, 1% risk per trade on capital
MARGIN_MULTIPLIER=5
DEFAULT_RISK_PCT=1.0

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
